# 설정은 환경 변수 대신 이 파일(.env)에 둔다. 모두 선택 사항이고 기본값이 있다.

# Model
# EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
# EMBEDDING_DIM=384
# QUERY_PREFIX="query: "      # e5 계열 전용. 다른 모델은 빈 값으로
# PASSAGE_PREFIX="passage: "

# 임베딩 속도 (7교시 선택 실습 extra_embedding_speed.py)
# EMBEDDING_DEVICE=auto            # torch: auto | cuda | mps | cpu
# EMBEDDING_SORT_BY_LENGTH=true    # 길이순 배치로 패딩 줄이기
# EMBEDDING_NUM_THREADS=8          # CPU 스레드 수. 비우면 라이브러리 기본값

# MLflow (6 · 8교시 선택 실습). 있으면 train · evaluate · compare가 run을, api · cli · mcp가 트레이스를 남긴다
# MLFLOW_TRACKING_URI=http://127.0.0.1:5050

# Logging
# LOG_LEVEL=INFO
